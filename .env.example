# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى أي مستودع عام.

# التوكن الذي يعطيك إياه BotFather بعد إنشاء البوت
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرّفك الرقمي في تيليغرام (احصل عليه من بوت مثل @userinfobot)
# هذا هو الشخص الوحيد المسموح له بإرسال أوامر البث والإدارة
OWNER_ID=123456789

# ---------------------------------------------------------------------------
# البريد الإلكتروني (اختياري) - اتركها فارغة إن لم تُرد إرسال التذكيرات بالبريد
# ---------------------------------------------------------------------------
# Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_SECURITY=starttls
#          SMTP_PASSWORD = "كلمة مرور التطبيقات" (16 حرفًا) من:
#          https://myaccount.google.com/apppasswords  (يتطلب تفعيل التحقق بخطوتين)
# Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURITY=starttls
# Hostinger / cPanel: SMTP_HOST=smtp.hostinger.com (أو mail.yourdomain.com)  SMTP_PORT=465  SMTP_SECURITY=ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# العنوان الذي تظهر منه الرسائل (افتراضيًا = SMTP_USER) والاسم الظاهر للمستلم
EMAIL_FROM=
EMAIL_FROM_NAME=تذكير المواعيد
